{
  "name":  "Fixette",
  "description": "Display images of art pieces from museums around the globe in your new tab, to keep you curious and educated while coloring your day.",
  "version": "1.2.0",
  "manifest_version": 3,
  "author": "13BPs",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "Fixette@BackgrArt.com"
    }
  },

  "action":{
    "default_icon":{
      "16": "src/assets/icons/fixette_logo_500.png",
      "32": "src/assets/icons/fixette_logo_500_white.png"
    },
    "default_popup": "src/pages/popup/popup.html"
  },

  "chrome_url_overrides":{
    "newtab": "src/pages/newtab/newtab.html"
  },

  "icons":{
    "16": "src/assets/icons/fixette_logo_500.png",
    "48": "src/assets/icons/fixette_logo_500.png",
    "128": "src/assets/icons/fixette_logo_500.png"
  },

  "options_page":"src/html/options.html",

  "permissions": [
    "storage",
    "alarms",
    "topSites"
  ],

  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"],
      "extension_ids": ["*"]
    }
  ]
}
